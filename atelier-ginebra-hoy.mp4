/* ============================================================
   LUXURY WATCH — GLOBAL STYLESHEET
   Step 2: Variables, Reset, Base Layout, Breakpoints
   100% CSS — no JavaScript dependencies anywhere in this file.
   ============================================================ */

/* ------------------------------------------------------------
   1. FONT IMPORTS
   Display: Cormorant Garamond (headlines, brand)
   Body:    Inter (paragraphs, nav, form)
   Utility: JetBrains Mono (prices, refs, years — dial-style numerals)
------------------------------------------------------------- */
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');

/* ------------------------------------------------------------
   2. CSS VARIABLES — DESIGN TOKENS
------------------------------------------------------------- */
:root {
  /* ===== PALETA: "Laboratorio del Tiempo" ===== */

  /* Fondo y estructura */
  --color-obsidian: #0A0911;        /* Obsidian Ink — fondo dominante */
  --color-charcoal: #2A1E38;        /* Deep Velvet / Iridescent Violet — tarjetas, paneles */
  --color-charcoal-light: #3A2B4C;  /* Deep Velvet, variante clara — hover/active */

  /* Acento exclusivo: CTA, disponibilidad, punteros interactivos, tensión cromática */
  --color-accent: #2DD4BF;          /* Liquid Beryl */
  --color-accent-bright: #5EEAD4;   /* Liquid Beryl, variante luminosa */

  /* Texto */
  --color-text-primary: #E2E8F0;    /* Vapor Smoke — titulares, nombres, nav */
  --color-text-secondary: #94A3B8;  /* Titanium Dust — specs, metadatos, etiquetas consola */

  /* Alerta — únicamente para feedback de formulario (no forma parte del set decorativo) */
  --color-alert: #E4577E;
  --color-alert-bright: #F17FA0;

  /* Bordes y superposiciones — tono neutro (Titanium Dust), NO teñidos de Beryl,
     para preservar el acento como elemento exclusivo de alto impacto */
  --border-hairline: rgba(148, 163, 184, 0.14);
  --border-hairline-strong: rgba(148, 163, 184, 0.3);
  --overlay-dark: rgba(10, 9, 17, 0.72);
  --overlay-darker: rgba(10, 9, 17, 0.88);

  /* Glassmorphism */
  --glass-bg: rgba(42, 30, 56, 0.5);
  --glass-bg-strong: rgba(42, 30, 56, 0.62);
  --glass-blur: 12px;

  /* Glow sensorial — exclusivo de elementos Beryl */
  --glow-accent: 0 0 20px rgba(45, 212, 191, 0.3);
  --glow-accent-soft: 0 0 12px rgba(45, 212, 191, 0.2);

  /* Typography */
  --font-display: 'Cormorant Garamond', 'Playfair Display', serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', 'Courier New', monospace;

  /* Type scale */
  --fs-hero: clamp(2.75rem, 6vw, 6rem);
  --fs-h1: clamp(2.25rem, 4vw, 3.5rem);
  --fs-h2: clamp(1.75rem, 3vw, 2.5rem);
  --fs-h3: clamp(1.25rem, 2vw, 1.5rem);
  --fs-body: 1rem;
  --fs-small: 0.875rem;
  --fs-caption: 0.75rem;

  /* Spacing scale */
  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 2rem;
  --space-lg: 4rem;
  --space-xl: 6rem;
  --space-2xl: 9rem;

  /* Layout */
  --max-width: 1320px;
  --radius-sm: 2px;
  --radius-md: 4px;

  /* Transitions */
  --ease-luxury: cubic-bezier(0.22, 1, 0.36, 1);
  --transition-base: 0.4s var(--ease-luxury);
  --transition-slow: 0.7s var(--ease-luxury);
}

/* ------------------------------------------------------------
   3. RESET
------------------------------------------------------------- */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 88px; /* offsets sticky navbar height for anchor links */
}

body {
  font-family: var(--font-body);
  background-color: var(--color-obsidian);
  color: var(--color-text-primary);
  line-height: 1.6;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
ol {
  list-style: none;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

input,
textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.15;
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* Visible keyboard focus — accessibility floor */
a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}

/* ------------------------------------------------------------
   4. LAYOUT PRIMITIVES (Flexbox / Grid bases)
------------------------------------------------------------- */
.container {
  width: 100%;
  max-width: var(--max-width);
  margin-inline: auto;
  padding-inline: var(--space-md);
}

.flex {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.grid {
  display: grid;
  gap: var(--space-md);
}

.section {
  padding-block: var(--space-2xl);
  position: relative;
}

.section-alt {
  background-color: var(--color-charcoal);
}

/* Section heading pattern shared across the page */
.section-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--fs-caption);
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-text-secondary);
  display: inline-block;
  margin-bottom: var(--space-sm);
}

.section-title {
  font-size: var(--fs-h1);
  color: var(--color-text-primary);
  margin-bottom: var(--space-md);
}

.section-subtitle {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  max-width: 640px;
}

.section-header {
  text-align: center;
  margin-bottom: var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Reusable CTA button */
.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 0.9rem 2.25rem;
  font-family: var(--font-body);
  font-size: var(--fs-small);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 1px solid var(--color-accent);
  border-radius: var(--radius-sm);
  color: var(--color-obsidian);
  background-color: var(--color-accent);
  box-shadow: var(--glow-accent-soft);
  transition: background-color var(--transition-base), color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
}

.btn:hover {
  background-color: transparent;
  color: var(--color-accent-bright);
  transform: translateY(-2px);
  box-shadow: var(--glow-accent);
}

.btn-outline {
  background-color: transparent;
  color: var(--color-text-primary);
  border-color: var(--border-hairline-strong);
  box-shadow: none;
}

.btn-outline:hover {
  border-color: var(--color-accent);
  color: var(--color-accent-bright);
  background-color: transparent;
  box-shadow: var(--glow-accent-soft);
}

/* ------------------------------------------------------------
   5. RESPONSIVE BREAKPOINTS
   Mobile  : < 768px   (base styles above are mobile-first)
   Tablet  : 768px – 1024px
   Desktop : > 1024px
------------------------------------------------------------- */

/* ---- Tablet (>= 768px) ---- */
@media (min-width: 768px) {
  .container {
    padding-inline: var(--space-lg);
  }

  .grid-2-tablet {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ---- Desktop (>= 1025px) ---- */
@media (min-width: 1025px) {
  .grid-3-desktop {
    grid-template-columns: repeat(3, 1fr);
  }

  .grid-2-desktop {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ---- Small mobile refinements (< 480px) ---- */
@media (max-width: 480px) {
  .section {
    padding-block: var(--space-xl);
  }

  .container {
    padding-inline: var(--space-sm);
  }
}

/* ============================================================
   STEP 4 — COMPONENT STYLES, ANIMATIONS & INTERACTIONS
   ============================================================ */

/* ------------------------------------------------------------
   NAVBAR
------------------------------------------------------------- */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border-bottom: 1px solid var(--border-hairline);
}

.navbar__inner {
  height: 88px;
  position: relative;
}

.navbar__logo {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--color-text-primary);
}

.navbar__links {
  gap: var(--space-lg);
}

.navbar__links a {
  font-size: var(--fs-small);
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-text-primary);
  position: relative;
  padding-bottom: 4px;
  transition: color var(--transition-base);
}

.navbar__links a::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0;
  height: 1px;
  background-color: var(--color-accent);
  transition: width var(--transition-base);
}

.navbar__links a:hover {
  color: var(--color-accent-bright);
}

.navbar__links a:hover::after {
  width: 100%;
}

.navbar__cta {
  border: 1px solid var(--border-hairline-strong);
  padding: 0.5rem 1.25rem;
  border-radius: var(--radius-sm);
  transition: border-color var(--transition-base);
}

.navbar__cta:hover {
  border-color: var(--color-accent);
}

.navbar__cta::after {
  display: none;
}

/* Mobile nav toggle — pure CSS checkbox hack, zero JS */
.nav-toggle {
  display: none;
}

.nav-toggle__label {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 32px;
  height: 32px;
  cursor: pointer;
  z-index: 110;
}

.nav-toggle__label span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: var(--color-accent);
  transition: transform var(--transition-base), opacity var(--transition-base);
}

/* ------------------------------------------------------------
   HERO
------------------------------------------------------------- */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: var(--color-obsidian);
}

.hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  filter: saturate(0.9) brightness(0.85);
}

.hero__texture {
  position: absolute;
  inset: 0;
  background-image:
    repeating-conic-gradient(from 0deg, rgba(226,232,240,0.05) 0deg 2deg, transparent 2deg 8deg);
  background-position: center;
  mask-image: radial-gradient(circle at center, black 0%, transparent 72%);
  opacity: 0.5;
  z-index: 1;
  mix-blend-mode: soft-light;
}

/* Atmósfera orgánica Deep Velvet / Iridescent Violet — color-grade sobre el metraje real */
.hero__atmosphere {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(90vw, 900px);
  height: min(90vw, 900px);
  transform: translate(-50%, -50%);
  background: radial-gradient(circle at 42% 38%, rgba(58, 43, 76, 0.7) 0%, rgba(42, 30, 56, 0.4) 38%, transparent 68%);
  filter: blur(40px);
  z-index: 1;
  mix-blend-mode: overlay;
  pointer-events: none;
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at center, rgba(10,9,17,0.35) 0%, var(--color-obsidian) 88%),
    linear-gradient(to top, rgba(10,9,17,0.75) 0%, transparent 45%);
  z-index: 2;
}

.hero__watch {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(70vw, 620px);
  height: min(70vw, 620px);
  transform: translate(-50%, -50%);
  z-index: 2;
}

.hero__watch-face {
  position: absolute;
  inset: 0;
  border: 1px solid var(--border-hairline);
  border-radius: 50%;
}

.hero__watch-face::before {
  content: '';
  position: absolute;
  inset: 8%;
  border: 1px solid var(--border-hairline);
  border-radius: 50%;
}

.hero__watch-hand {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 1px;
  height: 42%;
  background: linear-gradient(to top, var(--color-accent-bright), transparent 90%);
  transform-origin: bottom center;
  transform: translate(-50%, -100%) rotate(0deg);
  animation: sweep 60s linear infinite;
}

.hero__watch-hub {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8px;
  height: 8px;
  background-color: var(--color-accent);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

@keyframes sweep {
  from { transform: translate(-50%, -100%) rotate(0deg); }
  to   { transform: translate(-50%, -100%) rotate(360deg); }
}

.hero__content {
  position: relative;
  z-index: 3;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fade-up 1.2s var(--ease-luxury) both;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero__title {
  font-size: var(--fs-hero);
  color: var(--color-text-primary);
  margin-block: var(--space-sm) var(--space-md);
  text-wrap: balance;
}

.hero__subtitle {
  font-size: 1.05rem;
  color: var(--color-text-secondary);
  max-width: 520px;
  margin-bottom: var(--space-md);
}

.hero__scroll-indicator {
  position: absolute;
  bottom: var(--space-md);
  left: 50%;
  transform: translateX(-50%);
  width: 22px;
  height: 36px;
  border: 1px solid var(--border-hairline-strong);
  border-radius: 12px;
  z-index: 3;
}

.hero__scroll-indicator span {
  position: absolute;
  top: 6px;
  left: 50%;
  width: 3px;
  height: 8px;
  background-color: var(--color-accent);
  border-radius: 2px;
  transform: translateX(-50%);
  animation: scroll-dot 1.8s ease-in-out infinite;
}

@keyframes scroll-dot {
  0%   { opacity: 1; top: 6px; }
  70%  { opacity: 0; top: 18px; }
  100% { opacity: 0; top: 6px; }
}

/* ------------------------------------------------------------
   FEATURED WATCHES / CARDS
------------------------------------------------------------- */
.watch-card {
  background-color: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border: 1px solid var(--border-hairline);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
}

.watch-card:hover {
  transform: translateY(-6px);
  border-color: var(--border-hairline-strong);
  box-shadow: 0 20px 40px rgba(0,0,0,0.35);
}

.watch-card__image-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4 / 5;
}

.watch-card__image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.watch-card:hover .watch-card__image-wrap img {
  transform: scale(1.08);
}

.watch-card__tag {
  position: absolute;
  top: var(--space-xs);
  right: var(--space-xs);
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.3rem 0.6rem;
  border-radius: var(--radius-sm);
  backdrop-filter: blur(4px);
}

/* Disponible: Beryl activo, con glow — indicador de disponibilidad (uso exclusivo del acento) */
.watch-card__tag--stock {
  background-color: rgba(45, 212, 191, 0.14);
  color: var(--color-accent-bright);
  border: 1px solid rgba(45, 212, 191, 0.4);
  box-shadow: var(--glow-accent-soft);
}

/* Agotado: mismo sistema Beryl pero atenuado — la ausencia se comunica por reducción, no por un color de alarma */
.watch-card__tag--out {
  background-color: rgba(45, 212, 191, 0.05);
  color: var(--color-text-secondary);
  border: 1px solid var(--border-hairline-strong);
}

.watch-card__body {
  padding: var(--space-md);
}

.watch-card__ref {
  font-family: var(--font-mono);
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
  margin-bottom: 0.25rem;
}

.watch-card__name {
  font-size: var(--fs-h3);
  margin-bottom: 0.5rem;
}

.watch-card__rating {
  font-size: 0.75rem;
  color: var(--color-text-secondary);
  letter-spacing: 1px;
  margin-bottom: var(--space-sm);
}

.watch-card__rating span {
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
  margin-left: 4px;
}

.watch-card__price {
  font-family: var(--font-mono);
  font-size: 1.15rem;
  color: var(--color-text-primary);
  margin-bottom: var(--space-sm);
}

.watch-card__btn {
  width: 100%;
  justify-content: center;
}

/* ------------------------------------------------------------
   HISTORY / TIMELINE / PHOTOS / TESTIMONIALS
------------------------------------------------------------- */
.history__intro {
  margin-bottom: var(--space-xl);
}

.history__text {
  color: var(--color-text-secondary);
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  border-left: 1px solid var(--border-hairline);
  padding-left: var(--space-md);
  margin-bottom: var(--space-xl);
}

.timeline__item {
  position: relative;
  display: flex;
  align-items: baseline;
  gap: var(--space-md);
}

.timeline__dot {
  position: absolute;
  left: calc(-1 * var(--space-md) - 5px);
  top: 4px;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background-color: var(--color-accent);
  box-shadow: var(--glow-accent-soft), 0 0 0 4px var(--color-charcoal);
}

.timeline__year {
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
  font-weight: 600;
  min-width: 60px;
}

.timeline__desc {
  color: var(--color-text-primary);
  font-size: var(--fs-small);
}

.history__compare {
  grid-template-columns: 1fr;
  margin-bottom: var(--space-xl);
}

.history__photo {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.history__photo img,
.history__photo video {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.history__photo figcaption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-sm);
  font-family: var(--font-mono);
  font-size: var(--fs-caption);
  background: linear-gradient(to top, var(--overlay-darker), transparent);
  color: var(--color-text-primary);
}

.testimonial {
  background-color: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border: 1px solid var(--border-hairline);
  border-radius: var(--radius-md);
  padding: var(--space-md);
}

.testimonial p {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1.15rem;
  color: var(--color-text-primary);
  margin-bottom: var(--space-sm);
}

.testimonial__author {
  gap: var(--space-xs);
}

.testimonial__author img {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.testimonial__author div {
  display: flex;
  flex-direction: column;
  font-size: var(--fs-small);
}

.testimonial__author cite {
  font-style: normal;
  font-weight: 600;
  color: var(--color-text-primary);
}

.testimonial__author span {
  color: var(--color-text-secondary);
  font-size: var(--fs-caption);
}

/* ------------------------------------------------------------
   CONTACT FORM — pure CSS validation states
------------------------------------------------------------- */
.contact__grid {
  gap: var(--space-xl);
}

.form-group {
  margin-bottom: var(--space-md);
  position: relative;
}

.form-group label {
  display: block;
  font-size: var(--fs-small);
  color: var(--color-text-secondary);
  margin-bottom: 0.4rem;
}

.form-group:has(input:required) label::after,
.form-group:has(textarea:required) label::after {
  content: ' *';
  color: var(--color-accent);
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 0.85rem 1rem;
  background-color: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border: 1px solid var(--border-hairline);
  border-radius: var(--radius-sm);
  color: var(--color-text-primary);
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.75;
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: var(--glow-accent-soft);
}

.contact-form input:not(:placeholder-shown):invalid,
.contact-form textarea:not(:placeholder-shown):invalid {
  border-color: var(--color-alert);
  box-shadow: 0 0 0 3px rgba(228, 87, 126, 0.18);
}

.contact-form input:not(:placeholder-shown):valid,
.contact-form textarea:not(:placeholder-shown):valid {
  border-color: var(--color-accent);
}

.contact-form__submit {
  width: 100%;
  justify-content: center;
  margin-top: var(--space-xs);
}

.contact__info h3 {
  font-size: var(--fs-h3);
  margin-bottom: var(--space-sm);
  margin-top: var(--space-lg);
}

.contact__info h3:first-child {
  margin-top: 0;
}

.contact-info-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.contact-info-list li {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  border-bottom: 1px solid var(--border-hairline);
  padding-bottom: var(--space-sm);
}

.contact-info-list__label {
  font-size: var(--fs-caption);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-secondary);
}

.contact-info-list a:hover {
  color: var(--color-accent-bright);
}

.social-links {
  gap: var(--space-md);
}

.social-links a {
  font-size: var(--fs-small);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--border-hairline-strong);
  padding-bottom: 2px;
  transition: color var(--transition-base), border-color var(--transition-base);
}

.social-links a:hover {
  color: var(--color-accent-bright);
  border-color: var(--color-accent);
}

/* ------------------------------------------------------------
   FOOTER
------------------------------------------------------------- */
.footer {
  border-top: 1px solid var(--border-hairline);
  padding-block: var(--space-md);
}

.footer__inner {
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.footer__brand {
  font-family: var(--font-display);
  font-weight: 600;
  color: var(--color-text-primary);
}

.footer__copy,
.footer__dev {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}

.footer__email {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}

.footer__email:hover,
.footer__dev a:hover {
  color: var(--color-accent-bright);
}

.footer__dev a {
  color: var(--color-accent);
  border-bottom: 1px solid var(--border-hairline-strong);
}

/* ============================================================
   RESPONSIVE OVERRIDES (Step 4 additions)
============================================================ */

@media (max-width: 767px) {
  .nav-toggle__label {
    display: flex;
  }

  .navbar__nav {
    position: absolute;
    top: 88px;
    left: 0;
    right: 0;
    background-color: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border-bottom: 1px solid var(--border-hairline);
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-base);
  }

  .navbar__links {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md);
  }

  .nav-toggle:checked ~ .navbar__nav {
    max-height: 320px;
  }

  .nav-toggle:checked ~ .nav-toggle__label span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle:checked ~ .nav-toggle__label span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle:checked ~ .nav-toggle__label span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .hero__watch {
    width: 90vw;
    height: 90vw;
    opacity: 0.6;
  }

  .footer__inner {
    flex-direction: column;
    text-align: center;
  }
}

@media (min-width: 768px) and (max-width: 1024px) {
  .history__compare {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1025px) {
  .history__compare {
    grid-template-columns: repeat(2, 1fr);
  }

  .timeline {
    flex-direction: row;
    justify-content: space-between;
    border-left: none;
    border-top: 1px solid var(--border-hairline);
    padding-left: 0;
    padding-top: var(--space-md);
  }

  .timeline__item {
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
  }

  .timeline__dot {
    left: 0;
    top: calc(-1 * var(--space-md) - 5px);
  }
}
